# Copy to D:\app-runtime\config\development\split.identity.env, outside Git.
APP_ENV=development
# Windows must supply the confirmed public HTTPS domain; no domain has been supplied yet.
AUTH_PUBLIC_URL=https://REPLACE-WITH-CONFIRMED-SPLIT-DEV-HOST/api/auth
AUTH_SECRET_FILE=D:\app-runtime\secrets\development\split-auth-development.key
AUTH_EMAIL_KEY_FILE=D:\app-runtime\secrets\development\split-email-development.key
# Exactly ONE Web/Server OAuth client ID from the Split Google project, not iOS/Android IDs.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.dddcreate.split.dev
# Apple audience alone does not configure Apple Developer signing.
MAIL_ENABLED=true
SMTP_FROM=contact@dddcreate.com
SMTP_REPLY_TO=split@dddcreate.com
SMTP_MESSAGE_DOMAIN=dddcreate.com
MAIL_ALLOWLIST=999delights@gmail.com
# SMTP_HOST, SMTP_PORT, SMTP_SECURITY, SMTP_USER, SMTP_PASSWORD come from the Windows loader.
# Never add their values, signing keys, passwords or tokens to Git.
