# Copy outside Git on the Windows host. Values are per product and environment.
APP_ENV=development
AUTH_PUBLIC_URL=https://YOUR-APP-API/api/auth
AUTH_SECRET_FILE=D:\app-runtime\secrets\YOUR-APP-auth-development.key
AUTH_EMAIL_KEY_FILE=D:\app-runtime\secrets\YOUR-APP-email-development.key
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Alias for incoming replies; SMTP authentication still uses the real mailbox.
SMTP_REPLY_TO=
SMTP_MESSAGE_DOMAIN=
MAIL_ALLOWLIST=
